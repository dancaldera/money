<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.money.paperscan</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/danielcaldera/money/scripts/daily_paper_run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/danielcaldera/money</string>

    <!-- Run at 18:05 Mexico City time: just after the 00:00 UTC crypto daily
         close and after the US equity close. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>5</integer>
    </dict>

    <!-- Don't fire the moment it's loaded; wait for the scheduled time. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- The wrapper manages results/paper_scan.log itself (rotation, notify).
         These capture only catastrophic errors before that takes over. -->
    <key>StandardOutPath</key>
    <string>/Users/danielcaldera/money/results/launchd.paperscan.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/danielcaldera/money/results/launchd.paperscan.log</string>
</dict>
</plist>
