<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.money.paperscan</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/danielcaldera/Documents/Desarrollo/money/scripts/daily_paper_run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/danielcaldera/Documents/Desarrollo/money</string>

    <!-- Run every day at 17:00 local time (after the US equity close in any US tz). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>17</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Don't fire the moment it's loaded; wait for the scheduled time. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/danielcaldera/Documents/Desarrollo/money/results/paper_scan.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/danielcaldera/Documents/Desarrollo/money/results/paper_scan.log</string>
</dict>
</plist>
