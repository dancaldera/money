[Unit]
Description=money lab — crypto close/context schedule (00:05 UTC)

[Timer]
# 00:05 UTC: just after the crypto daily close and after the US equity close —
# the latest closed crypto candle is fresh. Persistent=true fires a
# missed run on wake/boot (same behaviour launchd gave the Mac).
OnCalendar=*-*-* 00:05:00 UTC
Persistent=true
Unit=money-paperscan.service

[Install]
WantedBy=timers.target
