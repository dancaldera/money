# Alpaca PAPER trading credentials (free, fake money).
#
# 1. Create a free account at https://alpaca.markets
# 2. In the dashboard, switch to "Paper Trading" (top-left toggle).
# 3. Under "Home" / "API Keys", click "Generate New Key".
# 4. Copy them here, then: cp .env.example .env  (and fill in the values)
#
# These are PAPER keys — they cannot touch real money. Never paste live-account
# keys here. The .env file is gitignored so your keys stay local.

ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
