# Alpaca PAPER trading credentials (free, fake money).
#
# 1. Create a free account at https://alpaca.markets
# 2. In the dashboard, switch to "Paper Trading" (top-left toggle).
# 3. Under "Home" / "API Keys", click "Generate New Key".
# 4. Copy them here, then: cp .env.example .env  (and fill in the values)
#
# These are PAPER keys — they cannot touch real money. Never paste live-account
# keys here. The .env file is gitignored so your keys stay local.

ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# ---------------------------------------------------------------------------
# Email updates (optional — used by `money email-report` and the scheduled
# wrappers). Plain SMTP: any provider works. For Gmail create an App Password
# at https://myaccount.google.com/apppasswords (2FA must be enabled) and use
# it as the password below. Port 587 uses STARTTLS; 465 uses implicit SSL.
# Leave these unset to disable emailing entirely.
#
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=you@gmail.com
# EMAIL_SMTP_PASSWORD=your_16_char_app_password
# EMAIL_TO=you@gmail.com            # comma-separated recipients
# EMAIL_FROM=you@gmail.com          # optional; defaults to EMAIL_SMTP_USER
